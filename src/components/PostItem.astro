---
import type { Post } from '../lib/posts';
import { fmtDate } from '../lib/posts';
import { categoryName } from '../data/site';
interface Props { post: Post }
const { post } = Astro.props;
const { title, subtitle, date, category, draft } = post.data;
---
<a class="item" href={`/posts/${post.id}/`}>
  <span class="text">
    <span class="title">{draft && <span class="draft">초안</span>}{title}</span>
    {subtitle && <span class="sub">{subtitle}</span>}
  </span>
  <span class="meta">{fmtDate(date)} · {categoryName(category)}</span>
</a>
<style>
  .item { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .item:hover .title { color: var(--accent); }
  .text { display: flex; flex-direction: column; gap: 6px; flex: 999 1 480px; min-width: 0; }
  .title { font-size: 18px; font-weight: 700; line-height: 1.5; }
  .sub { font-size: 14.5px; color: var(--muted); }
  .meta { font-size: 13px; color: var(--subtle); white-space: nowrap; }
  .draft { font-size: 12px; font-weight: 700; color: #9A4A12; background: #FDEEDF; padding: 2px 8px; border-radius: 6px; margin-right: 8px; vertical-align: 2px; }
</style>
