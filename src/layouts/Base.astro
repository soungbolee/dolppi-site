---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;        // 페이지 제목 (없으면 홈)
  description?: string;
  ogImage?: string;
  article?: { published: Date; modified?: Date };
}
const { title, description = SITE.description, ogImage = '/img/og-default.png', article } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogUrl = new URL(ogImage, SITE.url).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/posts/', label: '블로그' },
  { href: '/company/', label: '회사 연재 모음' },
  { href: '/#portfolio', label: '포트폴리오' },
  { href: '/about/', label: '소개' },
];
const year = new Date().getFullYear();
const isActive = (href: string) =>
  href === '/posts/' ? path.startsWith('/posts') || path.startsWith('/category') : !href.includes('#') && path.startsWith(href);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:locale" content="ko_KR" />
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  {SITE.naverVerification && <meta name="naver-site-verification" content={SITE.naverVerification} />}
  {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand">
        <Logo />
        <span class="brand-text"><span class="brand-name">{SITE.name}</span><span class="brand-tag">{SITE.tagline}</span></span>
      </a>
      <nav aria-label="주 메뉴" class="nav">
        {nav.map((n) => (
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-about">
        <p class="footer-title">{SITE.name} · {SITE.tagline}</p>
        <p>SAP·Snowflake 데이터 플랫폼과 데이터 연결, 지식그래프, 클로드·Joule·MCP 기반 AI 에이전트를 다룹니다. 이 블로그의 글은 개인 의견이며 소속 회사의 공식 입장이 아닙니다.</p>
        <a href="/about/">글쓴이 소개 →</a>
      </div>
      <nav aria-label="연락처" class="footer-links">
        {SITE.linkedin && <a href={SITE.linkedin} rel="me">LinkedIn</a>}
        {SITE.email && <a href={`mailto:${SITE.email}`}>이메일</a>}
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
    <div class="wrap copyright">© {year} {SITE.name} · dolppi.com</div>
  </footer>
</body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .header-inner { padding-top: 18px; padding-bottom: 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .brand-text { display: flex; flex-direction: column; gap: 1px; }
  .brand-name { font-family: var(--font-head); font-weight: 700; font-size: 20px; line-height: 1.2; }
  .brand-tag { font-size: 12.5px; color: var(--subtle); line-height: 1.3; }
  .nav { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 15px; font-weight: 500; }
  .nav a { text-decoration: none; color: #3B4556; padding: 8px 0; }
  .nav a[aria-current='page'] { color: var(--accent); font-weight: 700; }
  .site-footer { background: var(--night); color: #C3CAD5; margin-top: 64px; }
  .footer-inner { padding-top: 48px; padding-bottom: 24px; display: flex; flex-wrap: wrap; gap: 32px; justify-content: space-between; }
  .footer-about { flex: 999 1 420px; min-width: 0; font-size: 14.5px; line-height: 1.75; }
  .footer-about p { margin: 0 0 10px; }
  .footer-title { font-family: var(--font-head); font-weight: 700; font-size: 20px; color: #fff; }
  .site-footer a { color: #8FD3CC; text-decoration: none; font-weight: 700; font-size: 14px; }
  .footer-links { display: flex; flex-direction: column; gap: 10px; }
  .copyright { padding-bottom: 28px; font-size: 13px; color: #8A93A1; }
</style>
